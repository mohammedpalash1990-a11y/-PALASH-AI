# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Owner / Admin credentials for Phase 1 authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Neon PostgreSQL connection string (e.g., postgresql://user:pass@host/palash_ai?sslmode=require)
DATABASE_URL=

# Optional GitHub Personal Access Token for private repository inspection & push workflows
GITHUB_TOKEN=

# Optional GitHub OAuth App credentials for one-click browser authorization
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
