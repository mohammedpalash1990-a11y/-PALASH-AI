# GEMINI API
# Required for mission planning, specialist execution, chat, and code analysis.
# Get a key at https://aistudio.google.com/apikey (server-side only — never ship it to the client).
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash.
# Use a model id your key can access, e.g. gemini-2.5-pro.
GEMINI_MODEL=

# Optional request timeout for Gemini calls (ms). Default 45000.
GEMINI_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Owner / authentication
# ---------------------------------------------------------------------------
# When ADMIN_EMAIL + ADMIN_PASSWORD are set they take precedence over the
# first-run "claim owner account" screen, and rotating ADMIN_PASSWORD rotates
# the stored credential on next boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# REQUIRED in production (NODE_ENV=production): random 32+ character HMAC key.
# In development a secret is generated once and stored at .data/.jwt-secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Server port (default 3000)
PORT=3000

# development | production | test
NODE_ENV=development

# Optional override for the local JSON state directory (default ./.data)
PALASH_DATA_DIR=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Neon / Postgres connection string. Read-only queries and schema inspection are
# proxied through this; the local JSON store remains the source of truth.
DATABASE_URL=

# TLS policy for DATABASE_URL: verify-full (recommended) | require | disable
# Default (unset): encrypted but certificate not verified (legacy behaviour).
PGSSLMODE=

# Statement timeout for Postgres queries (ms). Default 15000.
PG_STATEMENT_TIMEOUT_MS=

# GitHub Personal Access Token for private repository inspection.
GITHUB_TOKEN=

# GitHub API request timeout (ms). Default 15000.
GITHUB_TIMEOUT_MS=
